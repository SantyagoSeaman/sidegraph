{
  "mcpServers": {
    "sidegraph": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/SantyagoSeaman/sidegraph.git@rc/0.14.0-1",
        "sidegraph-mcp",
        "--repo-root"
      ],
      "env": {
        "SIDEGRAPH_DIR": ".sidegraph",
        "SIDEGRAPH_GRAPH": "graphify-out/graph.json"
      }
    }
  }
}
