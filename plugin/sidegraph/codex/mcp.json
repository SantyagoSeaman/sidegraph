{
  "sidegraph": {
    "command": "uvx",
    "args": [
      "--from",
      "git+https://github.com/SantyagoSeaman/sidegraph.git@main",
      "sidegraph-mcp",
      "--repo-root"
    ],
    "env": {
      "SIDEGRAPH_DIR": ".sidegraph",
      "SIDEGRAPH_GRAPH": "graphify-out/graph.json"
    }
  }
}
