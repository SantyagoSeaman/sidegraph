{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SIDEGRAPH_HOST=grok uvx --from sidegraph==0.29.0 --python 3.13 sidegraph-session-start --repo-root || echo '{\"systemMessage\":\"Sidegraph: the SessionStart hook could not start (uv, the first download of Sidegraph, or no network); run the hook command in a terminal to see the error\"}'",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SIDEGRAPH_HOST=grok uvx --from sidegraph==0.29.0 --python 3.13 sidegraph-stop --repo-root || echo '{}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "SIDEGRAPH_HOST=grok uvx --from sidegraph==0.29.0 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "p=$(cat); case \"$p\" in *[!A-Za-z0-9_]'sed '*|*\\\\[ntr]'sed '*|*[!A-Za-z0-9_]'grep '*|*\\\\[ntr]'grep '*|*[!A-Za-z0-9_]'rg '*|*\\\\[ntr]'rg '*|*[!A-Za-z0-9_]'cat '*|*\\\\[ntr]'cat '*) printf '%s\\n' \"$p\" | { SIDEGRAPH_HOST=grok uvx --from sidegraph==0.29.0 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}' ; } ;; *) echo '{}' ;; esac",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "SIDEGRAPH_HOST=grok uvx --from sidegraph==0.29.0 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SIDEGRAPH_HOST=grok uvx --from sidegraph==0.29.0 --python 3.13 sidegraph-subagent-start --repo-root || echo '{}'",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
