{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "SIDEGRAPH_HOST=claude uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-session-start --repo-root || echo '{\"systemMessage\":\"Sidegraph: the SessionStart hook could not start (uv, the first download of Sidegraph, or no network); run the hook command in a terminal to see the error\"}'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-stop --repo-root || echo '{}'"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read|Grep|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(sed *)",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'"
          },
          {
            "type": "command",
            "if": "Bash(grep *)",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'"
          },
          {
            "type": "command",
            "if": "Bash(rg *)",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'"
          },
          {
            "type": "command",
            "if": "Bash(cat *)",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'"
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-pre-tool-use --repo-root || echo '{}'"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uvx --from sidegraph==0.25.1 --python 3.13 sidegraph-subagent-start --repo-root || echo '{}'"
          }
        ]
      }
    ]
  }
}
